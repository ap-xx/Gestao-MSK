# Segredo para assinar os JWTs — troque por uma string longa e aleatória em produção
JWT_SECRET=troque_este_segredo_por_algo_longo_e_aleatorio

# Senhas de app: myaccount.google.com → Segurança → Senhas de app
# (a conta precisa ter verificação em duas etapas ativada)

# ── Admin ────────────────────────────────────────────────────
GMAIL_USER_ADMIN=admin@gmail.com
GMAIL_APP_PASSWORD_ADMIN=xxxx xxxx xxxx xxxx

# ── Advogado ─────────────────────────────────────────────────
GMAIL_USER_ADVOGADO=advogado@gmail.com
GMAIL_APP_PASSWORD_ADVOGADO=xxxx xxxx xxxx xxxx

# ── Assistente ───────────────────────────────────────────────
GMAIL_USER_ASSISTENTE=assistente@gmail.com
GMAIL_APP_PASSWORD_ASSISTENTE=xxxx xxxx xxxx xxxx

PORT=3001
