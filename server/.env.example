# Segredo para assinar os JWTs — troque por uma string longa e aleatória em produção
JWT_SECRET=troque_este_segredo_por_algo_longo_e_aleatorio

# Gmail SMTP — conta que envia os e-mails de notificação
# GMAIL_USER: o e-mail do remetente
# GMAIL_APP_PASSWORD: senha de app gerada em myaccount.google.com → Segurança → Senhas de app
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Porta do servidor (padrão: 3001)
PORT=3001
