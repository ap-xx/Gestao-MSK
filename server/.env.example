# Segredo para assinar os JWTs — troque por uma string longa e aleatória em produção
JWT_SECRET=troque_este_segredo_por_algo_longo_e_aleatorio

# Chave da API do Resend (obtenha em https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# E-mail remetente verificado no Resend (domínio próprio ou onboarding@resend.dev para testes)
EMAIL_REMETENTE=notificacoes@seudominioaqui.com.br

# Porta do servidor (padrão: 3001)
PORT=3001
